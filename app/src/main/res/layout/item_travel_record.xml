<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTravel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Photo Thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:background="#F1F5F9"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

        <!-- Travel Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLocationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/tvRating"
                    android:layout_marginEnd="8dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    tools:text="Artisan Coffee &amp; Architecture" />

                <!-- Rating Pill Tag -->
                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="#15F59E0B"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#D97706"
                    tools:text="★ 4.8" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                tools:text="GPS: -19.9213, -43.9450" />

            <TextView
                android:id="@+id/tvCommentSnippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_body"
                tools:text="Stunning modernist architecture with specialty pour-over coffee." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
